    <!-- ros2_control configuration for Gazebo -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        
        <joint name="joint1">
            <command_interface name="position">
                <param name="min">-2.617994</param>
                <param name="max">2.617994</param>
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        
        <joint name="joint2">
            <command_interface name="position">
                <param name="min">-1.047198</param>
                <param name="max">1.745329</param>
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        
        <joint name="joint3">
            <!-- Spawn already at the rest pose instead of driving to it.
                 gz_ros2_control seeds the joint from initial_value, so the
                 twin appears standing where a run starts rather than folded
                 flat at zero and then visibly swinging up on the first
                 simulate_ros_initial_position of every session. Only joint3
                 differs from zero in that pose (J1..J6 = 0,0,90,0,0,0 in
                 simulate.py), so it is the only one that needs a seed.
                 1.5708 rad = 90 deg. -->
            <command_interface name="position">
                <param name="min">0.314159</param>
                <param name="max">2.443461</param>
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position">
                <param name="initial_value">1.5708</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        
        <joint name="joint4">
            <command_interface name="position">
                <param name="min">-2.967060</param>
                <param name="max">2.967060</param>
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        
        <joint name="joint5">
            <command_interface name="position">
                <param name="min">-1.658063</param>
                <param name="max">2.356194</param>
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        
        <joint name="joint6">
            <command_interface name="position">
                <param name="min">-2.967060</param>
                <param name="max">2.967060</param>
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        
        <!-- Range della pinza: [-0.015, 0] come in Cobotta.sdf.template, che è
             il modello che Gazebo carica per la fisica. NON allineare questi
             due valori al <joint name="joint_left"/"joint_right"><limit> più
             sopra in questo stesso file ([0, 0.01]): quel limite non descrive
             la pinza reale e allinearlo qui fa troncare ogni comando allo
             stesso estremo, con la pinza che non si chiude più (2026-07-30). -->
        <joint name="joint_left">
            <command_interface name="position">
                <param name="min">-0.015</param>
                <param name="max">0.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint_right">
            <command_interface name="position">
                <param name="min">-0.015</param>
                <param name="max">0.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>
    
    <!-- Gazebo plugin for ros2_control -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        </plugin>
    </gazebo>

