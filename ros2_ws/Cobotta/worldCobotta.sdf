<?xml version="1.0" ?>
<sdf version="1.11">
  <world name="worldCobotta">
    <scene>
      <grid>false</grid>
    </scene>
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_contacts>12</max_contacts>
      <ode>
        <solver>
          <type>world</type>
          <iters>100</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>1e-10</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
      </engine>
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
<gui>
      <!-- 3D scene visualization -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre</engine>
        <scene>scene</scene>
       
        <camera_pose>-9.5 -2 1.5 0 0 1</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>2000</far>
        </camera_clip>
      </plugin>

      <!-- Play / pause / step -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>false</step>
        <start_paused>false</start_paused>
      </plugin>

      <!-- Joint position controller -->
      <plugin filename="JointPositionController" name="JointPositionController">
        <gz-gui>
          <property type="double" key="height">600</property>
          <property type="double" key="width">400</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="collapsed">true</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <model_name>Cobotta</model_name>
      </plugin>

      <!-- Scene management plugins -->
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>



    <include>
      <name>Cobotta</name>
      <pose>-9.0 -1.2 1.05 0 0 0</pose>
      <uri>
        model://Cobotta.sdf
      </uri>
    </include>
    
    <!-- Pick-side tube rack. Same model file the place side spawns
         (locations/tube_rack) — the two racks are one physical object in the
         real cell, so they must not become two geometries here.

         Included statically instead of spawned per run: the pick rack never
         changes, and every create/remove cycle is a chance to hit the
         "physics entity ptr ... does not exist" errors the object spawns
         already produce.

         Pose = the pick point itself, because the model's origin is the
         centre of slot 0: x = ROBOT_BASE_X + DEFAULT_PICK_X_REL = -9.0 + -0.05,
         y = ROBOT_BASE_Y + DEFAULT_PICK_Y_REL = -1.2 + -0.28,
         z = TABLE_TOP_Z_ABS. No rotation, so model-X runs along robot X and
         slot i lands on PICK_RACK_PROFILE's slot_xy_offsets[i] (calibration.py).
         Keep this pose in sync with those constants. -->
    <include>
      <name>PickTubeRack</name>
      <static>true</static>
      <pose>-9.05 -1.48 1.0134 0 0 0</pose>
      <uri>
        model://locations/tube_rack/model.sdf
      </uri>
    </include>

    <model name="SimpleTable">
      <static>true</static>
      <!-- Top = ROBOT_BASE_Z + PICK_Z_REF_OFFSET (calibration.py) = 1.05 - 0.0366 = 1.0134.
           Keep this pose and PICK_Z_REF_OFFSET in sync — see the import-time assert
           in calibration.py that catches drift between them. -->
      <pose>-9.0 -1.2 0.4934 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 1.5 1.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 1.5 1.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cobotta Base Plate Set (DENSO official accessory) — the real cell mounts
         the robot on this stand, 36.6mm between the table top and the robot's
         foot (base.dae origin sits at the foot). Without it the twin would show
         the robot floating above the table now that SimpleTable moved down to
         match the measured real-cell geometry. Two-plate approximation with
         primitives (no mesh download) — refine footprint/finish with calipers
         at the next physical session. -->
    <model name="RobotBasePlate">
      <static>true</static>
      <pose>-9.0 -1.2 0 0 0 0</pose>
      <link name="plate">
        <visual name="lower_star_a">
          <pose>0 0 1.020 0 0 0.7854</pose>
          <geometry>
            <box><size>0.30 0.085 0.012</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
        <visual name="lower_star_b">
          <pose>0 0 1.020 0 0 -0.7854</pose>
          <geometry>
            <box><size>0.30 0.085 0.012</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
        <visual name="upper_plate">
          <pose>0 0 1.042 0 0 0</pose>
          <geometry>
            <box><size>0.14 0.14 0.014</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.33 1</ambient>
            <diffuse>0.45 0.45 0.5 1</diffuse>
            <specular>0.7 0.7 0.7 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 1.026 0 0 0</pose>
          <geometry>
            <box><size>0.16 0.16 0.036</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="overhead_camera">
      <static>true</static>
      <!-- Side view of the Cobotta arm (looking toward +Y, slight downward tilt). -->
      <pose>-9.0 -2.6 1.5 0 0.15 1.5708</pose>
      <link name="camera_link">
        <sensor name="overhead_cam" type="camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <!-- 5, not 15. Measured on the dev VM (no GPU, llvmpipe software
               rasterisation) 2026-09-03: this one number is the simulation's
               whole speed budget.

                 camera 15Hz .......... RTF 0.398
                 camera  5Hz .......... RTF 0.954
                 no camera at all ..... RTF 1.000

               Everything else that looked expensive is not. The ODE solver
               (`world`, the exact LCP one) and a 1ms step were both measured
               against their cheaper alternatives — quickstep, and a 2ms step —
               and each bought under 5%, well inside the noise of what the
               camera decides. So the solver and the step stay as they were
               rather than trading contact accuracy for nothing: this cell
               places 18mm tubes into 2mm-walled containers, and the
               calibration is tuned against this physics.

               Resolution stays 640x480 on purpose. The frames feed YOLO and
               the cap-colour classifier as well as the operator's live view,
               and dropping pixels would change what the vision pipeline can
               see. Dropping the RATE does not. -->
          <update_rate>5</update_rate>
          <topic>/gz/camera/image</topic>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

  </world>
</sdf>