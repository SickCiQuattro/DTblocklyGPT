<?xml version="1.0"?>
<model>
  <name>tube_rack</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>
  <description>Red 4-slot test tube rack, shared by the pick and place ends of the cell (worldCobotta.sdf includes it statically for pick; _h_place spawns it with yaw +90 for place). Origin = centre of slot 0. Slots pitch 22.23 mm, interior 20.63x22 mm, wall height 35 mm, token 0.5 mm floor. Static model.</description>
</model>
