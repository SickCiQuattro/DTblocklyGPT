<?xml version="1.0" ?>
<sdf version="1.5">
  <!--
    3-slot test tube rack.
    Origin = centre of middle slot.
    Slots along model-X: x ∈ {-0.027, 0, +0.027}  (27 mm pitch)
    Slot interior: 22 × 22 mm, depth 35 mm.
    Total height: 45 mm (base 10 mm + walls 35 mm).
    Spawned with yaw +90°, so model-X aligns to robot Y-axis.
    Robot-relative slot Y: {-0.237, -0.210, -0.183} (from LOCATION_SPAWN_Y = -1.41)
  -->
  <model name="tube_rack">
    <static>true</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Base plate -->
      <collision name="col_base">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry><box><size>0.086 0.032 0.010</size></box></geometry>
        <surface>
          <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="vis_base">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry><box><size>0.086 0.032 0.010</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
      </visual>

      <!-- Transverse dividing walls (4 walls create 3 slots) -->
      <!-- Wall at x = -0.0405 (left outer) -->
      <collision name="col_wall_0">
        <pose>-0.0405 0 0.0275 0 0 0</pose>
        <geometry><box><size>0.005 0.032 0.035</size></box></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>100</kd></ode></contact><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_wall_0">
        <pose>-0.0405 0 0.0275 0 0 0</pose>
        <geometry><box><size>0.005 0.032 0.035</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
      </visual>

      <!-- Wall at x = -0.0135 (left inner) -->
      <collision name="col_wall_1">
        <pose>-0.0135 0 0.0275 0 0 0</pose>
        <geometry><box><size>0.005 0.032 0.035</size></box></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>100</kd></ode></contact><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_wall_1">
        <pose>-0.0135 0 0.0275 0 0 0</pose>
        <geometry><box><size>0.005 0.032 0.035</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
      </visual>

      <!-- Wall at x = +0.0135 (right inner) -->
      <collision name="col_wall_2">
        <pose>0.0135 0 0.0275 0 0 0</pose>
        <geometry><box><size>0.005 0.032 0.035</size></box></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>100</kd></ode></contact><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_wall_2">
        <pose>0.0135 0 0.0275 0 0 0</pose>
        <geometry><box><size>0.005 0.032 0.035</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
      </visual>

      <!-- Wall at x = +0.0405 (right outer) -->
      <collision name="col_wall_3">
        <pose>0.0405 0 0.0275 0 0 0</pose>
        <geometry><box><size>0.005 0.032 0.035</size></box></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>100</kd></ode></contact><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_wall_3">
        <pose>0.0405 0 0.0275 0 0 0</pose>
        <geometry><box><size>0.005 0.032 0.035</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
      </visual>

      <!-- Front lateral wall (y = -0.0135) -->
      <collision name="col_side_front">
        <pose>0 -0.0135 0.0275 0 0 0</pose>
        <geometry><box><size>0.086 0.005 0.035</size></box></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>100</kd></ode></contact><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_side_front">
        <pose>0 -0.0135 0.0275 0 0 0</pose>
        <geometry><box><size>0.086 0.005 0.035</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
      </visual>

      <!-- Back lateral wall (y = +0.0135) -->
      <collision name="col_side_back">
        <pose>0 0.0135 0.0275 0 0 0</pose>
        <geometry><box><size>0.086 0.005 0.035</size></box></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>100</kd></ode></contact><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_side_back">
        <pose>0 0.0135 0.0275 0 0 0</pose>
        <geometry><box><size>0.086 0.005 0.035</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
      </visual>

    </link>
  </model>
</sdf>
