<?xml version="1.0" ?>
<sdf version="1.7">
  <!--
    Waste bin: an open cylinder, 140 mm across and 80 mm deep, approximated
    by 8 flat panels.

    Built from primitives rather than the Google Scanned Objects mesh that used
    to occupy this folder. Three things were wrong with the mesh version, and
    they had one cause: get_location_profile() in simulate.py derives
    floor_height / is_container by scanning collisions for box and cylinder
    geometry, so a mesh location always reported is_container=False and every
    place there fell back to "hover above the rim and let go". The mesh also
    carried no <static> flag, so physics pushed the model around the table,
    and its internal <model name> did not match the folder name the backend
    resolves from the location's DB row.

    Height is deliberately 80 mm: that is the value
    resolve_location_metrics() already used as this folder's hard-coded
    fallback while the mesh yielded no dimensions, so rebuilding it at the
    same height leaves every existing place descent unchanged.
  -->
  <model name="waste_bin">
    <static>true</static>
    <link name="link">

      <collision name="col_floor">
        <pose>0 0 0.00100 0 0 0</pose>
        <geometry><box><size>0.09702 0.09702 0.00200</size></box></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_floor">
        <pose>0 0 0.00100 0 0 0</pose>
        <geometry><box><size>0.09702 0.09702 0.00200</size></box></geometry>
        <material><ambient>0.30 0.33 0.36 1</ambient><diffuse>0.30 0.33 0.36 1</diffuse></material>
      </visual>

      <collision name="col_wall_0">
        <pose>0.07000 0.00000 0.04000 0 0 0.00000</pose>
        <geometry><box><size>0.00300 0.06263 0.08000</size></box></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_wall_0">
        <pose>0.07000 0.00000 0.04000 0 0 0.00000</pose>
        <geometry><box><size>0.00300 0.06263 0.08000</size></box></geometry>
        <material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material>
      </visual>
      <collision name="col_wall_1">
        <pose>0.04950 0.04950 0.04000 0 0 0.78540</pose>
