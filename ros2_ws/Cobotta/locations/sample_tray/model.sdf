<?xml version="1.0" ?>
<sdf version="1.7">
  <!--
    Sample tray: a shallow rectangular tray, 130 x 95 mm, 20 mm deep.

    Built from primitives rather than the Google Scanned Objects mesh that used
    to occupy this folder. Three things were wrong with the mesh version, and
    they had one cause: get_location_profile() in simulate.py derives
    floor_height / is_container by scanning collisions for box and cylinder
    geometry, so a mesh location always reported is_container=False and every
    place there fell back to "hover above the rim and let go". The mesh also
    carried no <static> flag, so physics pushed the model around the table,
    and its internal <model name> did not match the folder name the backend
    resolves from the location's DB row.

    Depth is deliberately 20 mm — the value resolve_location_metrics() already
    used as this folder's hard-coded fallback — so existing place descents are
    unchanged. It is also the shallowest a container can be and still be read
    as one: is_container requires rim - floor >= 15 mm, and this leaves 16 mm.
  -->
  <model name="sample_tray">
    <static>true</static>
    <link name="link">

      <collision name="col_floor">
        <pose>0 0 0.00200 0 0 0</pose>
        <geometry><box><size>0.12200 0.08700 0.00400</size></box></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_floor">
        <pose>0 0 0.00200 0 0 0</pose>
        <geometry><box><size>0.12200 0.08700 0.00400</size></box></geometry>
        <material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material>
      </visual>

      <collision name="col_wall_x_pos">
        <pose>0.06300 0.00000 0.01000 0 0 0</pose>
        <geometry><box><size>0.00400 0.09500 0.02000</size></box></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_wall_x_pos">
        <pose>0.06300 0.00000 0.01000 0 0 0</pose>
        <geometry><box><size>0.00400 0.09500 0.02000</size></box></geometry>
        <material><ambient>0.90 0.90 0.92 1</ambient><diffuse>0.90 0.90 0.92 1</diffuse></material>
      </visual>
      <collision name="col_wall_x_neg">
        <pose>-0.06300 0.00000 0.01000 0 0 0</pose>
        <geometry><box><size>0.00400 0.09500 0.02000</size></box></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_wall_x_neg">
        <pose>-0.06300 0.00000 0.01000 0 0 0</pose>
        <geometry><box><size>0.00400 0.09500 0.02000</size></box></geometry>
        <material><ambient>0.90 0.90 0.92 1</ambient><diffuse>0.90 0.90 0.92 1</diffuse></material>
      </visual>
      <collision name="col_wall_y_pos">
        <pose>0.00000 0.04550 0.01000 0 0 0</pose>
        <geometry><box><size>0.13000 0.00400 0.02000</size></box></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_wall_y_pos">
        <pose>0.00000 0.04550 0.01000 0 0 0</pose>
        <geometry><box><size>0.13000 0.00400 0.02000</size></box></geometry>
        <material><ambient>0.90 0.90 0.92 1</ambient><diffuse>0.90 0.90 0.92 1</diffuse></material>
      </visual>
      <collision name="col_wall_y_neg">
        <pose>0.00000 -0.04550 0.01000 0 0 0</pose>
        <geometry><box><size>0.13000 0.00400 0.02000</size></box></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="vis_wall_y_neg">
        <pose>0.00000 -0.04550 0.01000 0 0 0</pose>
        <geometry><box><size>0.13000 0.00400 0.02000</size></box></geometry>
        <material><ambient>0.90 0.90 0.92 1</ambient><diffuse>0.90 0.90 0.92 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
