<?xml version="1.0" ?>
<sdf version="1.5">
  <!-- Banana: box 0.020 x 0.110 x 0.020 → min(x,y) width = 20mm (hand_close=16, requires fix 1.1) -->
  <model name="banana">
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <!-- box: ixx=(m/12)*(y²+z²), iyy=(m/12)*(x²+z²), izz=(m/12)*(x²+y²) -->
          <ixx>1.52e-5</ixx>
          <ixy>0</ixy><ixz>0</ixz>
          <iyy>1.78e-5</iyy>
          <iyz>0</iyz>
          <izz>1.59e-5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.020 0.110 0.020</size></box>
        </geometry>
        <surface>
          <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>1.0</coefficient><use_patch_radius>0</use_patch_radius><surface_radius>0.01</surface_radius></torsional></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.020 0.110 0.020</size></box></geometry>
        <material><ambient>1.0 0.9 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
