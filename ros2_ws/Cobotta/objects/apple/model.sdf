<?xml version="1.0" ?>
<sdf version="1.5">
  <!-- Apple: collision cylinder r=0.012 h=0.024 (parsable sphere approx) → width=24mm (hand_close=20) -->
  <model name="apple">
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.020</mass>
        <inertia>
          <ixx>1.25e-6</ixx>
          <ixy>0</ixy><ixz>0</ixz>
          <iyy>1.25e-6</iyy>
          <iyz>0</iyz>
          <izz>1.44e-6</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <!-- Cylinder approximation of sphere for parsable dimensions -->
          <cylinder><radius>0.012</radius><length>0.024</length></cylinder>
        </geometry>
        <surface>
          <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode><torsional><coefficient>1.0</coefficient><use_patch_radius>0</use_patch_radius><surface_radius>0.012</surface_radius></torsional></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.012</radius></sphere></geometry>
        <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
