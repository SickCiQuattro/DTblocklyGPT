<?xml version="1.0" ?>
<sdf version="1.5">
  <!-- Miniature bottle: r=0.011 h=0.08 → width=22mm (pickable, hand_close=18) -->
  <model name="bottle">
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.020</mass>
        <inertia>
          <!-- cylinder r=0.011 h=0.08: ixx=iyy=(m/12)*(3r²+h²), izz=mr²/2 -->
          <ixx>1.14e-5</ixx>
          <ixy>0</ixy><ixz>0</ixz>
          <iyy>1.14e-5</iyy>
          <iyz>0</iyz>
          <izz>1.21e-6</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.011</radius><length>0.08</length></cylinder>
        </geometry>
        <surface>
          <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>1.0</coefficient><use_patch_radius>0</use_patch_radius><surface_radius>0.011</surface_radius></torsional></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.011</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.3 0.6 1.0 0.8</ambient><diffuse>0.3 0.6 1.0 0.8</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
