<?xml version="1.0" ?>
<sdf version="1.5">
  <!-- Bottle: fat orange body r=0.013 h=0.08 (width=26mm), narrow red cap on top
       (visual only, no collision — grasp_center_offset/max_grasp_width in
       object.meta.json fully override the grasp plan regardless of the cap's
       own size). 2026-07-29: body widened from r=0.011 (22mm) per user render
       feedback ("cicciotto"/chubby bottom); cap added, narrower than the body,
       in red. hand_close/grasp height unchanged — meta.json's grasp point was
       already calibrated above this body (near the neck), independent of
       whatever geometry is drawn there. -->
  <model name="medicine_bottle">
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.020</mass>
        <inertia>
          <!-- cylinder r=0.013 h=0.08: ixx=iyy=(m/12)*(3r²+h²), izz=mr²/2 -->
          <ixx>1.15e-5</ixx>
          <ixy>0</ixy><ixz>0</ixz>
          <iyy>1.15e-5</iyy>
          <iyz>0</iyz>
          <izz>1.69e-6</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.013</radius><length>0.08</length></cylinder>
        </geometry>
        <surface>
          <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode><torsional><coefficient>1.0</coefficient><use_patch_radius>0</use_patch_radius><surface_radius>0.013</surface_radius></torsional></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.013</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.95 0.45 0 1</ambient><diffuse>0.95 0.45 0 1</diffuse></material>
      </visual>

      <!-- Cap: visual only, no collision — see model-level comment above. -->
      <visual name="visual_cap">
        <pose>0 0 0.038 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.007</radius><length>0.012</length></cylinder>
        </geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
