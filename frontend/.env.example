# Backend Data
VITE_BACKEND_PROTOCOL = '' # ex. http://
VITE_BACKEND_HOST = '' # localhost
VITE_BACKEND_PORT = '' # :8000

# Frontend Data — read by django_project_conf/settings.py (CSRF_TRUSTED_ORIGINS),
# not by any frontend code — required despite the VITE_ prefix, Django 4.0+ fails
# to start if this resolves to an empty string.
VITE_FRONTEND_PROTOCOL = '' # http://
VITE_FRONTEND_HOST = '' # localhost
VITE_FRONTEND_PORT = '' # :3000

# Optional — each already falls back to a working default, only set to override
# VITE_SOCKET_PROTOCOL = '' # default: http:// (polling_socket_node SocketIO server)
# VITE_SOCKET_PORT = '' # default: :5001 — same host as VITE_BACKEND_HOST
# VITE_CAMERA_STREAM_URL = '' # default: /camera/stream?topic=/camera/image_raw&type=mjpeg (Vite dev-proxy); set an absolute URL for a production build served from Django
# VITE_SPEECH_LANG = '' # default: it-IT — BCP-47 tag the Web Speech recognizer listens in.
#   Pinned rather than taken from the browser locale, so a session's outcome does not
#   depend on which laptop it ran on. Set it to the language the OPERATOR SPEAKS, which
#   is not the interface language: the UI is English, the study's operators are Italian.
#   Shared by the voice-command block and the chat dictation button — one browser
#   recognition session serves both, so there is only ever one language in effect.
